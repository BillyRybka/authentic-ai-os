# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Obsidian workspace state (keep config, ignore local UI state)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Logs
*.log

# Claude local
.claude/settings.local.json
.claude/.credentials.json
.claude/skills/*-workspace/

# Work-in-progress skills (prefix with _ to keep out of releases)
.claude/skills/_*/

# Billy's strategy + working files (never ships to clients)
build-plan.md
*.log
_scratch/
_strategy/
_notes/
# Dev scratch inside skills: machine paths + named third-party refs. Never ships.
*WORKING-NOTES.md
*DECISIONS.md
.claude/voice-audit-log.md

# Vault content NEVER ships. The repo is the plugin source only.
# Bank schemas live in knowledge/{bank}-schema.md.
# Clients get an empty workspace scaffolded by creator-setup at runtime.
# If any of these folders appear locally (test runs, accidental scaffold), keep them out of git.
# Anchored to repo root ON PURPOSE. Unanchored `foundation/` once swallowed
# plugins/aai-youtube/skills/foundation/ and silently dropped a skill from a
# release build. Anchored patterns cannot reach inside plugins/ or shared-skills/.
/foundation/
/content/
/people/
/companies/
/resources/
/raw/
/notes/
/banks/
/Authentic-AI-OS/

# Test fixtures intentionally mirror a real vault (foundation/, banks/, people/,
# content/) so the vid-* skills can run against them. Re-include the whole tests/
# tree even though the personal-data patterns above match these folder names at
# any depth. tests/ never ships: the release allowlist ($ShipSkills) only copies
# named skills plus referenced knowledge, so test infra cannot reach main.
!tests/
!tests/**

# Release artifacts (.plugin files generated by scripts/release.ps1)
dist/

# Temp / scratch artifacts
.tmp-*
diagram-preview.png
excalidraw.log

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.pyc
